#!/bin/sh
set -eu
command -v zstd > /dev/null && packs=buildcache || packs=buildcache-gz
release=${NANOCODE_BUILDCACHE_RELEASE:-https://api.github.com/repos/nanocodexyz/nanocode/releases/tags/$packs}
dir=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/remote
rm -rf "$dir.next"
mkdir -p "$dir.next/units" "$dir.next/workspace"
base=$(printf %s "$release" | sed -n 's,^https://api.github.com/repos/\([^/]*/[^/]*\)/releases/tags/\([^/]*\)$,https://github.com/\1/releases/download/\2,p')
helper=helper-$(cksum < "${0%/*}/buildcache.rs" | cut -d' ' -f1)-$(uname -sm | tr ' ' -)
bundle=
rm -rf "$dir.bundle"
if [ -n "$base" ] && command -v xz > /dev/null && mkdir "$dir.bundle" && mkfifo "$dir.bundle/done"; then
  {
    : > "$dir.bundle/packs"
    parts=
    for part in 1 2 3; do
      { curl -sfL "$base/workspace-eager-blocks-$part" | xz -dcq -T0 > "$dir.bundle/part$part"; } &
      parts="$parts $!"
    done
    if curl -sfL "$base/workspace-eager-blocks-0" | xz -dcq -T0 >> "$dir.bundle/packs"; then
      part=1
      for pid in $parts; do
        wait "$pid" && cat "$dir.bundle/part$part" >> "$dir.bundle/packs" || break
        part=$((part + 1))
      done
    elif [ ! -s "$dir.bundle/packs" ]; then
      { curl -sfL "$base/workspace-eager-blocks" || curl -sfL "$base/workspace-eager-packs"; } | xz -dcq -T0 > "$dir.bundle/packs"
    fi
    rm -f "$dir.bundle/part1" "$dir.bundle/part2" "$dir.bundle/part3"
    : > "$dir.bundle/done"
  } < /dev/null > /dev/null 2>&1 &
  bundle=$!
  trap 'if [ -n "$bundle" ]; then kill "$bundle" 2> /dev/null; rm -rf "$dir.bundle"; fi' EXIT
fi
prebuilt=
head=$dir.next/head.d
if [ -n "$base" ] && curl -sfL -o "$dir.next/head" "$base/workspace-head-${helper#helper-}" && mkdir "$head" &&
  { gzip -dc < "$dir.next/head" 2> /dev/null || zstd -dcq < "$dir.next/head"; } | tar -xf - -C "$head" && [ -s "$head/index" ]; then
  mv "$head/eager" "$dir.next/eager"
  mv "$head/index" "$dir.next/workspace/index"
  mv "$head/helper" "$dir.next/helper"
elif [ -n "$base" ]; then
  curl -sfL -Z --parallel-immediate -o "$dir.next/eager" "$base/workspace-eager" -o "$dir.next/index" "$base/workspace-index" -o "$dir.next/helper" "$base/workspace-$helper" || true
  { [ -s "$dir.next/index" ] && { gzip -dc < "$dir.next/index" > "$dir.next/workspace/index" 2> /dev/null || zstd -dcq < "$dir.next/index" > "$dir.next/workspace/index"; }; } || rm -f "$dir.next/workspace/index"
fi
if [ -s "$dir.next/eager" ] && [ -s "$dir.next/workspace/index" ]; then
  echo "$base/{dir}-{key}" > "$dir.next/url"
  name=$(grep "^workspace-$helper-[0-9a-f]*$" "$dir.next/eager" || true)
  [ -s "$dir.next/helper" ] && [ -n "$name" ] && mv "$dir.next/helper" "$dir.next/workspace/${name#workspace-}" && prebuilt=$dir/workspace/${name#workspace-}
  grep -E '^(units|workspace)-[0-9a-f]{64}$' "$dir.next/eager" > "$dir.next/pending" || rm -f "$dir.next/pending"
else
  curl -sfL "$release" | grep -o '"browser_download_url": *"[^"]*"' | sed 's/.*"\(http[^"]*\)"/\1/' | while read -r url; do
    name=${url##*/}
    printf 'url = "%s"\noutput = "%s/%s/%s"\n' "$url" "$dir.next" "${name%%-*}" "${name#*-}"
  done > "$dir.next/config"
  curl -sfL -Z -K "$dir.next/config"
fi
rm -rf "$dir.next/config" "$dir.next/eager" "$dir.next/index" "$dir.next/helper" "$dir.next/head" "$head"
rm -rf "$dir"
mv "$dir.next" "$dir"
if [ -n "$bundle" ] && [ -n "$prebuilt" ] && [ -f "$dir/pending" ] && chmod 755 "$prebuilt" && mv "$dir/pending" "$dir/pending.$$"; then
  "$prebuilt" "${0%/*}" fetch-pending "$dir/pending.$$" "$dir.bundle" < /dev/null > /dev/null 2>&1 &
  bundle=
fi
echo "file://$dir/{dir}/{key}"
