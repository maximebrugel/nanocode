#!/usr/bin/env bash
# scripts/check: the checks below, one green/red line each with its time, then GREEN or RED.
#   scripts/check          changed scope: the crates the diff touches plus their dependents
#                          (cargo check: --lib --bins --examples native, --lib wasm32), and the simulator scenarios that
#                          reach those crates: their pass jobs and every canary they list
#   scripts/check --full   release gate: the whole workspace, every scenario and canary, and the unit tests
#                          (cargo test --lib --bins) of the crates whose tests pass (FULL_TESTS in bin/nc-build/src/check.rs)
#   scripts/check --list-stages      the --full plan's stages, one per line (each memory gate combo is its own)
#   scripts/check --stage NAME ...   only those stages of --full, logging to output/check-stages/<stages>/: shards of
#                          --full can run at once in one worktree, with a target dir each or a shared one
# Options: --base REF (diff base; default: merge-base with the upstream, or HEAD~1 when nothing
#   differs), -j N (parallel jobs; default: CARGO_BUILD_JOBS, else the cores it may run on),
#   --seeds N (seeds per pass job; default 8, 64 with --full), --no-sim, --plan (print the scope only).
# The engine is 'nc-build check' (bin/nc-build, crates/runtime/build-opt), built from this worktree
# in the fast profile, so a change to the gate checks itself. Logs: output/check/<check>.log.
# Target dir: cargo's (CARGO_TARGET_DIR, else the box cargo shim's <worktree>/target, else ./target),
# one per worktree: its .owner file names the worktree, and one owned by another worktree is refused.
# RUSTC_WRAPPER is left as the caller has it: blank would turn the configured compiler cache off.
# Cores: CARGO_BUILD_JOBS when set; else, where the nc-build slot ledger lists this machine, a lease of
#   NANOCODE_CHECK_CORES (default 16) cores, run under its taskset and given back on exit; with no room
#   for them within NANOCODE_CHECK_WAIT seconds (default 600) it takes what is free (half, a quarter, ...
#   down to 2 cores), else keeps waiting, and logs which; it never builds unleased on a listed machine.
#   On a machine the ledger doesn't list: every core this process may run on.
set -uo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
case " $* " in *" -h "* | *" --help "*) sed -n '2,23p' "$0"; exit 0 ;; esac
export SHIPPY_REMOTE_BUILD=0 CARGO_TERM_COLOR=never
# python-capi's wasm32 libc++ needs clang 22 (as scripts/pin-rebuild.sh sets); an explicit NANOCODE_CC wins.
if [ -z "${NANOCODE_CC:-}" ] && [ -x /usr/lib/llvm-22/bin/clang ]; then export NANOCODE_CC=/usr/lib/llvm-22/bin/clang PATH=/usr/lib/llvm-22/bin:$PATH; fi
prefix=()
lease=""
give() { [ -z "$lease" ] || nc-build slots give "$lease" >/dev/null 2>&1; lease=""; }
if [ -z "${CARGO_BUILD_JOBS:-}" ] && command -v nc-build >/dev/null 2>&1 &&
  nc-build slots list 2>/dev/null | grep -q "^$(hostname) "; then
  want=${NANOCODE_CHECK_CORES:-16} patience=${NANOCODE_CHECK_WAIT:-600} t0=$SECONDS
  take() { nc-build slots take --cores "$1" --label "check ${root##*/}" --machine "$(hostname)" ${2:+--wait "$2"} 2>&1; }
  leased() { read -r lease cores cpus < <(printf '%s' "$1" | python3 -I -c 'import json, sys; l = json.load(sys.stdin); print(l["lease"], l["cores"], l["cpus"])' 2>/dev/null); }
  trap give EXIT
  trap 'give; exit 130' INT TERM
  out=$(take "$want" "$patience")
  until leased "$out"; do
    # No room for $want within the wait: take what is free now, halving down to 2 cores, else wait again.
    n=$((want / 2))
    while [ "$n" -ge 2 ] && ! leased "$(take "$n")"; do n=$((n / 2)); done
    if [ -n "$lease" ]; then
      echo "scripts/check: no room for $want cores in $((SECONDS - t0))s; took the $cores free cores (lease $lease)" >&2
      break
    fi
    echo "scripts/check: no nc-build slot lease in $((SECONDS - t0))s ($out); still waiting for $want cores, not building unleased" >&2
    s=$SECONDS
    out=$(take "$want" "$patience")
    [ $((SECONDS - s)) -ge 30 ] || sleep 30  # a take that fails at once (ledger unreachable) waits too
  done
  [ "$cores" = "$want" ] && [ $((SECONDS - t0)) -ge 5 ] && echo "scripts/check: waited $((SECONDS - t0))s for a lease of $want cores (lease $lease)" >&2
  export CARGO_BUILD_JOBS=$cores NC_BUILD_LEASE=$lease NC_BUILD_LEASE_CORES=$cores
  prefix=(taskset -c "$cpus")
fi
# The engine builds in the worktree's own target dir, like everything the check builds.
mkdir -p output
if ! "${prefix[@]}" cargo build --locked --profile fast -p nc-build >output/check-engine.log 2>&1; then
  printf 'FAIL engine     building nc-build failed (output/check-engine.log)\n'
  { grep -E '^error' -A5 output/check-engine.log | head -20; tail -3 output/check-engine.log; } | sed 's/^/     | /'
  printf 'RED   nanocode (engine)\n'
  exit 1
fi
target=$(cargo metadata --format-version 1 --no-deps --offline 2>/dev/null | python3 -I -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])') || target=${CARGO_TARGET_DIR:-$root/target}
"${prefix[@]}" "$target/fast/nc-build" check "$@"
